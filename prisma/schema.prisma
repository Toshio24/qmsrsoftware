// QMS Document Trace Matrix — data model.
// See /Users/toshin/.claude/plans/compiled-weaving-graham.md for the design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  QA
  AUTHOR
  APPROVER
  AUDITOR_READONLY
}

enum ItemType {
  USER_NEED
  DESIGN_INPUT
  DESIGN_OUTPUT
  RISK_ITEM
  RISK_CONTROL
  VERIFICATION_TEST
  VALIDATION_TEST
  CONTROLLED_DOCUMENT
  SUPPLIER
  SUPPLIER_AUDIT
  CAPA
  NONCONFORMANCE
  COMPLAINT
  INTERNAL_AUDIT
  MANAGEMENT_REVIEW
  TRAINING_RECORD
  EQUIPMENT
}

enum ItemStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  REJECTED
  RETIRED
  OBSOLETE
}

enum LinkType {
  DERIVED_FROM
  SATISFIES
  VERIFIES
  VALIDATES
  MITIGATES
  IMPLEMENTS
  REFERENCES
  RESULTED_FROM
  ADDRESSES
  SUPPLIED_BY
  TRAINED_ON
  USED_EQUIPMENT
}

enum LinkStatus {
  ACTIVE
  REMOVED
}

enum RiskControlType {
  DESIGN
  PROTECTIVE
  INFORMATION
}

enum SupplierApprovalStatus {
  PENDING
  APPROVED
  CONDITIONAL
  DISQUALIFIED
}

enum SupplierAuditType {
  ONSITE
  REMOTE
  DOCUMENT_REVIEW
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
}

enum NonconformanceDisposition {
  USE_AS_IS
  REWORK
  SCRAP
  RETURN_TO_SUPPLIER
}

enum TestOutcome {
  PASS
  FAIL
  BLOCKED
}

enum SignatureMeaning {
  AUTHORED
  REVIEWED
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  LINK_ADD
  LINK_REMOVE
  ATTACHMENT_ADD
  ATTACHMENT_REMOVE
  SIGNATURE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  EXPORT
  USER_ROLE_CHANGE
  DELETE
}

// ---------- Users & sessions ----------

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  fullName           String
  email              String    @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean   @default(true)
  forcePasswordReset Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  sessions Session[]

  createdItems       TraceItem[]  @relation("ItemCreatedBy")
  signatures         ESignature[]
  linksCreated       TraceLink[]  @relation("LinkCreatedBy")
  linksRemoved       TraceLink[]  @relation("LinkRemovedBy")
  attachmentsAdded   Attachment[] @relation("AttachmentAddedBy")
  attachmentsRemoved Attachment[] @relation("AttachmentRemovedBy")
  foldersCreated     Folder[]
  testsExecuted      TestResult[] @relation("TestExecutedBy")
  testsReviewed      TestResult[] @relation("TestReviewedBy")

  userNeedVersions           UserNeedVersion[]
  designInputVersions        DesignInputVersion[]
  designOutputVersions       DesignOutputVersion[]
  riskItemVersions           RiskItemVersion[]
  riskControlVersions        RiskControlVersion[]
  verificationTestVersions   VerificationTestVersion[]
  validationTestVersions     ValidationTestVersion[]
  controlledDocumentVersions ControlledDocumentVersion[]
  supplierVersions           SupplierVersion[]
  supplierAuditVersions      SupplierAuditVersion[]
  capaVersions               CapaVersion[]
  nonconformanceVersions     NonconformanceVersion[]
  complaintVersions          ComplaintVersion[]
  internalAuditVersions      InternalAuditVersion[]
  managementReviewVersions   ManagementReviewVersion[]
  trainingRecordVersions     TrainingRecordVersion[]
  equipmentVersions          EquipmentVersion[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  ipAddress      String?

  @@index([userId])
  @@map("sessions")
}

// ---------- Trace item identity (class-table-inheritance root) ----------

model TraceItem {
  id               String     @id @default(uuid())
  itemType         ItemType
  humanCode        String     @unique
  title            String
  status           ItemStatus @default(DRAFT)
  currentVersionNo Int        @default(1)
  createdById      String
  createdBy        User       @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())

  // Which folder (if any) this item is filed under, within its own item
  // type's folder tree — see Folder below. Null means "unfiled" / root.
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  userNeedVersions           UserNeedVersion[]
  designInputVersions        DesignInputVersion[]
  designOutputVersions       DesignOutputVersion[]
  riskItemVersions           RiskItemVersion[]
  riskControlVersions        RiskControlVersion[]
  verificationTestVersions   VerificationTestVersion[]
  validationTestVersions     ValidationTestVersion[]
  controlledDocumentVersions ControlledDocumentVersion[]
  supplierVersions           SupplierVersion[]
  supplierAuditVersions      SupplierAuditVersion[]
  capaVersions               CapaVersion[]
  nonconformanceVersions     NonconformanceVersion[]
  complaintVersions          ComplaintVersion[]
  internalAuditVersions      InternalAuditVersion[]
  managementReviewVersions   ManagementReviewVersion[]
  trainingRecordVersions     TrainingRecordVersion[]
  equipmentVersions          EquipmentVersion[]

  testResults TestResult[]

  linksAsSource TraceLink[] @relation("LinkSource")
  linksAsTarget TraceLink[] @relation("LinkTarget")

  attachments Attachment[]

  @@index([itemType])
  @@index([status])
  @@index([folderId])
  @@map("trace_items")
}

// ---------- Folders (per item type, nestable) ----------
// A lightweight organizational layer, independent of the version/link/audit
// model above: users can group items of the same type into folders and
// subfolders (e.g. "Verification Tests" > "Protocols"). Deleting a folder
// never deletes its contents — items and subfolders move up to the parent
// (or root) instead; see repository layer.

model Folder {
  id             String      @id @default(uuid())
  itemType       ItemType
  name           String
  parentFolderId String?
  parentFolder   Folder?     @relation("FolderParent", fields: [parentFolderId], references: [id])
  subfolders     Folder[]    @relation("FolderParent")
  items          TraceItem[]
  status         LinkStatus  @default(ACTIVE)
  createdById    String
  createdBy      User        @relation(fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([itemType])
  @@index([parentFolderId])
  @@map("folders")
}

// ---------- Per-type append-only version tables ----------
// Rows here are never updated or deleted by the application — an edit always
// inserts a new version and bumps TraceItem.currentVersionNo.

model UserNeedVersion {
  id            String    @id @default(uuid())
  traceItemId   String
  traceItem     TraceItem @relation(fields: [traceItemId], references: [id])
  versionNumber Int
  needText      String
  rationale     String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([traceItemId, versionNumber])
  @@map("user_need_versions")
}

