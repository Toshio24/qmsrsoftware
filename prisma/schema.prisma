// Atomic per-type counter backing human-readable codes (e.g. SUP-014).
// Incremented inside the same transaction as item creation to avoid races.
model ItemSequence {
  itemType   ItemType @id
  lastNumber Int      @default(0)

  @@map("item_sequences")
}

// ---------- Test execution results (separate from the test definition) ----------

model TestResult {
  id                  String      @id @default(uuid())
  traceItemId         String
  traceItem           TraceItem   @relation(fields: [traceItemId], references: [id])
  versionNumberTested Int
  executedById        String
  executedBy          User        @relation("TestExecutedBy", fields: [executedById], references: [id])
  executedAt          DateTime    @default(now())
  result              TestOutcome
  actualResults       String?
  attachmentUrl       String?
  reviewedById        String?
  reviewedBy          User?       @relation("TestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?

  @@index([traceItemId])
  @@map("test_results")
}

// ---------- Trace links (any TraceItem -> any TraceItem, typed) ----------
// Removed links are soft-deleted (status = REMOVED), never hard-deleted, so
// history survives in the audit trail. Preventing duplicate ACTIVE links for
// the same (source, target, linkType) is enforced in the repository layer,
// not a DB constraint, since Postgres partial unique indexes aren't
// expressible in the Prisma schema DSL.

model TraceLink {
  id           String     @id @default(uuid())
  sourceItemId String
  sourceItem   TraceItem  @relation("LinkSource", fields: [sourceItemId], references: [id])
  targetItemId String
  targetItem   TraceItem  @relation("LinkTarget", fields: [targetItemId], references: [id])
  linkType     LinkType
  status       LinkStatus @default(ACTIVE)
  createdById  String
  createdBy    User       @relation("LinkCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  removedById  String?
  removedBy    User?      @relation("LinkRemovedBy", fields: [removedById], references: [id])
  removedAt    DateTime?

  @@index([sourceItemId])
  @@index([targetItemId])
  @@map("trace_links")
}

// ---------- Attachments (any TraceItem -> a named reference link) ----------
// Informal reference links (e.g. a Google Doc), distinct from the
// compliance-critical, version-scoped googleDocUrl/pdfSnapshotUrl fields on
// ControlledDocumentVersion. Removed attachments are soft-deleted, same
// pattern as TraceLink.

model Attachment {
  id          String     @id @default(uuid())
  traceItemId String
  traceItem   TraceItem  @relation(fields: [traceItemId], references: [id])
  name        String
  url         String
  status      LinkStatus @default(ACTIVE)
  addedById   String
  addedBy     User       @relation("AttachmentAddedBy", fields: [addedById], references: [id])
  addedAt     DateTime   @default(now())
  removedById String?
  removedBy   User?      @relation("AttachmentRemovedBy", fields: [removedById], references: [id])
  removedAt   DateTime?

  @@index([traceItemId])
  @@map("attachments")
}

// ---------- Audit trail (append-only) ----------
// Immutability is enforced two ways: (1) every mutation goes through the
// repository layer, which writes the domain change and this row in a single
// transaction, and (2) a Postgres role with no UPDATE/DELETE grant on this
// table plus a BEFORE UPDATE OR DELETE trigger, applied via raw migration SQL
// (see prisma/migrations — not expressible in this schema file).

model AuditLog {
  id                    BigInt      @id @default(autoincrement())
  entityType            String
  entityId              String
  action                AuditAction
  actorUserId           String?
  actorUsernameSnapshot String
  timestamp             DateTime    @default(now())
  beforeState           Json?
  afterState            Json?
  reasonForChange       String?
  ipAddress             String?
  requestId             String?

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([timestamp])
  @@map("audit_log")
}

// ---------- Electronic signatures (21 CFR Part 11 §11.50/11.70/11.100) ----------
// Bound to one specific immutable *Version row (entityId), never to "the
// item" in general. Re-authentication at signing time is enforced in the
// application layer (server independently re-verifies the password), not
// representable in the schema.

model ESignature {
  id                      String           @id @default(uuid())
  entityType              String
  entityId                String
  signerId                String
  signer                  User             @relation(fields: [signerId], references: [id])
  meaning                 SignatureMeaning
  signedAt                DateTime         @default(now())
  attestationTextSnapshot String
  contentHash             String
  ipAddress               String?

  @@index([entityType, entityId])
  @@index([signerId])
  @@map("e_signatures")
}
