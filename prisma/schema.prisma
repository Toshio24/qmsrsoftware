// Controlled documents: named on the platform, optionally linked to a live
// Google Doc, with a required PDF snapshot at approval time (see plan §
// "Important Caveats" — a live Google Doc is not an immutable record).
model ControlledDocumentVersion {
  id                String    @id @default(uuid())
  traceItemId       String
  traceItem         TraceItem @relation(fields: [traceItemId], references: [id])
  versionNumber     Int
  docName           String
  controlNumber     String
  revision          String
  googleDocUrl      String?
  pdfSnapshotUrl    String?
  effectiveDate     DateTime?
  reviewCycleMonths Int?
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  @@unique([traceItemId, versionNumber])
  @@map("controlled_document_versions")
}

